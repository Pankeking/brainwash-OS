{
  "name": "brainwash",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "APP_ENV=dev vite dev",
    "dev:prod": "APP_ENV=prod vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"import('node:fs').then((fs) => fs.rmSync('.test-dist', { recursive: true, force: true }))\" && pnpm exec tsc -p tsconfig.test.json && node --test .test-dist/tests/**/*.test.js",
    "lint": "eslint .",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint:fix": "eslint . --fix && prettier . --write",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "fix": "pnpm lint:fix"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-query-devtools": "^5.90.0",
    "@tanstack/react-router": "^1.161.3",
    "@tanstack/react-router-devtools": "^1.161.3",
    "@tanstack/react-router-ssr-query": "^1.161.3",
    "@tanstack/react-start": "^1.161.3",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.575.0",
    "mongoose": "^9.2.1",
    "nitro": "npm:nitro-nightly@latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redaxios": "^0.5.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
